{
  "name": "tdx-rail-thsr-cli",
  "version": "0.1.0",
  "description": "Taiwan High Speed Rail (THSR) CLI tool powered by TDX API",
  "type": "module",
  "bin": {
    "thsr": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lis186/tdx-rail-thsr-cli.git"
  },
  "homepage": "https://github.com/lis186/tdx-rail-thsr-cli#readme",
  "bugs": {
    "url": "https://github.com/lis186/tdx-rail-thsr-cli/issues"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "dotenv": "^16.4.7",
    "ofetch": "^1.4.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "msw": "^2.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "taiwan",
    "high-speed-rail",
    "thsr",
    "tdx",
    "cli",
    "timetable",
    "train",
